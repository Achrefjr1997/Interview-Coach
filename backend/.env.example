# Ollama Cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=your_key_here
OLLAMA_MODEL=gpt-oss:120b

# Tavily Search
TAVILY_API_KEY=your_tavily_key_here

# Database
COACH_DATABASE_URL=sqlite+aiosqlite:///./data/coach.db
COACH_CHECKPOINTER_DB=./data/checkpoints.db

# Auth
SECRET_KEY=change-this-to-a-random-64-char-string
SESSION_COOKIE_NAME=coach_session
SESSION_TTL_HOURS=72

# Server
CORS_ORIGINS=http://localhost:5173
PORT=8000

# Interview defaults
DEFAULT_MAX_QUESTIONS=10
DEFAULT_START_DIFFICULTY=2
MEMORY_WINDOW=6
EMA_ALPHA=0.4
